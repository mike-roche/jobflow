# Database - SQLite (file path)
DATABASE_URL="file:./jobflow.db"

# Server
PORT=4000
FRONTEND_URL=http://localhost:3000

# Comma-separated list of additional CORS origins (e.g. LAN IP for remote dev)
# CORS_ORIGINS=http://192.168.1.10:3000

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# AI Providers (at least one required)
# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...
# Override the Anthropic model used (defaults to claude-sonnet-4-5)
# ANTHROPIC_MODEL=claude-sonnet-4-5

# MiniMax
MINIMAX_API_KEY=...
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M2.7

# Default AI provider (optional, defaults to 'anthropic')
AI_PROVIDER=anthropic

# Job search sources
# Remotive, Remote OK and Arbeitnow need no key and are always on.
# Optional keyed sources (free sign-up): Adzuna https://developer.adzuna.com, Jooble https://jooble.org/api/about
ADZUNA_API_KEY=
ADZUNA_APP_ID=
# ADZUNA_COUNTRY=us
JOOBLE_API_KEY=
# Unofficial Indeed mirror on RapidAPI (paid, fragile)
INDEED_API_KEY=

# Job-alert email ingest (LinkedIn / Indeed alerts) - see docs/EMAIL_INGEST.md
# Reads your mailbox read-only and adds jobs from alert emails; also used to send alert digests.
MAIL_PROVIDER=outlook
MAIL_USER=
# Azure app registration client ID (Outlook/Hotmail requires OAuth); then run: npm run mail:login
MS_CLIENT_ID=
# MS_TENANT=consumers
# Non-Outlook mailboxes: set IMAP_HOST and an app password instead of MS_CLIENT_ID
# IMAP_HOST=outlook.office365.com
# IMAP_PORT=993
# IMAP_PASSWORD=
# Comma-separated folders to scan (use your rule's folder if alerts are filed away from the inbox)
EMAIL_INGEST_FOLDERS=INBOX
EMAIL_INGEST_INTERVAL_MINUTES=30
EMAIL_INGEST_LOOKBACK_DAYS=14
# JobFlow account that receives ingested jobs (defaults to the built-in local user)
# JOBFLOW_USER_EMAIL=

# Scheduler (runs email ingest and job alerts inside the backend)
SCHEDULER_ENABLED=true
ALERT_CHECK_INTERVAL_MINUTES=60
# Where alert digests go when using the built-in local user (defaults to MAIL_USER)
# ALERT_EMAIL_TO=
# Shared secret for POST /api/alerts/check-all (external cron); endpoint is disabled when unset
# CRON_SECRET=

# File Storage (optional - defaults to local './uploads')
UPLOAD_DIR=./uploads
STORAGE_TYPE=local

# Outgoing email for alert digests - optional. With MAIL_PROVIDER=outlook and mail:login done,
# leave SMTP_PASS empty and digests are sent from MAIL_USER via Outlook OAuth.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# EMAIL_FROM defaults to MAIL_USER
EMAIL_FROM=